/datum/computer_file/data/text/paperwork/foundation_goal
	filename = "FoundationGoal"
	stored_data = @{"[center][o5logo][/center]
[center][b][h2]ДИРЕКТИВА ПО ИССЛЕДОВАНИЯМ №%doc_number%[/h2][/b][/center]
[small][b]Объект:[/b] [u]Зона 53[/u][/small]
[small][b]Время:[/b] [u][time][/u][/small]
[small][b]Дата:[/b] [u][date][/u][/small]

В соответствии с директивой Совета О5 от %prev_date%, на объекте Зона-53 утвержден план приоритетных исследований аномальных объектов. Настоящая директива определяет перечень обязательных экспериментальных процедур на текущий операционный период.

[hr]

%scp_block_1%

[hr]

%scp_block_2%

[hr]

[b]РЕКОМЕНДАЦИИ ПО ПРОВЕДЕНИЮ ЭКСПЕРИМЕНТОВ:[/b]
В ходе выполнения всех экспериментальных процедур разрешается использование персонала класса D. Данное решение утверждено директивой Отдела Стратегических Исследований и направлено на получение максимально полных данных об объектах в условиях, приближенных к реальным. Использование класса D должно быть обосновано в финальных отчетах с указанием причин применения и оценкой всех сопутствующих рисков.

[b]ОСОБЫЕ УКАЗАНИЯ ПО БЕЗОПАСНОСТИ:[/b]
В случае нарушения условий содержания любого из перечисленных объектов, исследовательская группа обязана немедленно прекратить работу и следовать протоколам чрезвычайного реагирования согласно Руководству по безопасности Зоны-53. Приоритетом является сохранение целостности сдерживающих систем и безопасность всего персонала объекта.

[hr]

[center][b]ПОДПИСИ[/b][/center]

[b]Инициатор директивы:[/b]
[small]Доктор Кондратенко
Руководитель Отдела Стратегических Исследований[/small]
[small][i]Подпись: ______________[/i][/small]

[b]Утверждено:[/b]
[small]Совет О5[/small]
[small][i]Подпись: ______________[/i][/small]

[hr]

[b]ПОСТАНОВЛЯЕТСЯ:[/b]
По окончании экспериментальных процедур предоставить в Отдел Стратегических Исследований два отчета:
[olist]
[*]Отчет о проведенных исследованиях с фиксацией всех наблюдаемых эффектов и отклонений.
[*]Аналитическая записка с выводами и рекомендациями по дальнейшей работе с объектами.
[/olist]
Отчеты должны быть подписаны руководителем исследовательской группы и заверены печатью Отдела Стратегических Исследований.

[hr]

[i]*Данная директива вступает в силу с момента получения и подлежит незамедлительному исполнению.[/i]"}

/datum/foundation_goal
	var/list/selected_scps = list()
	var/report_message = ""

/datum/foundation_goal/New()
	..()
	generate_scp_goals()

/datum/foundation_goal/proc/generate_scp_goals()
	var/list/all_scps = list(
		"SCP-049", "SCP-096", "SCP-004", "SCP-012", "SCP-066",
		"SCP-008", "SCP-017", "SCP-035", "SCP-280", "SCP-247",
		"SCP-457", "SCP-939", "SCP-1507", "SCP-2427-3"
	)
	var/list/shuffled = shuffle(all_scps)
	selected_scps = shuffled.Copy(1, 3)
	report_message = generate_report()

/datum/foundation_goal/proc/generate_report()
	var/doc_number = rand(100, 999)
	var/prev_date = "[rand(1, 28)].[rand(1, 12)].[rand(2023, 2026)]"

	var/list/scp_data = list(
		"SCP-049" = list("class" = "Euclid", "task" = "Изучить поведение SCP-049 при взаимодействии с живыми организмами, чтобы понять логику его действий. Особое внимание требуется уделить его \"лечебным\" процедурам — необходимо задокументировать, что именно происходит с тканями в процессе и какие факторы влияют на его решения. На основе полученных данных попытаться выявить закономерности в его поведенческих паттернах и определить, можно ли на них как-то повлиять извне."),
		"SCP-096" = list("class" = "Euclid", "task" = "Выяснить, какие именно стимулы активируют SCP-096 и насколько сильно его реакция зависит от внешних условий. Необходимо провести серию тестов с различными типами визуальных раздражителей, чтобы определить точный порог срабатывания объекта. Также важно изучить, можно ли как-то контролировать или прерывать его агрессивную реакцию после активации."),
		"SCP-004" = list("class" = "Euclid", "task" = "Исследовать природу пространственных аномалий внутри проходов SCP-004, чтобы понять, как устроены эти измерения и что находится за их пределами. Необходимо задокументировать все эффекты, возникающие при перемещении через проходы, включая влияние на сознание и физическое состояние людей. Также важно выяснить, существуют ли закономерности в поведении проходов и можно ли предсказать их активность."),
		"SCP-012" = list("class" = "Euclid", "task" = "Изучить механизм психологического воздействия SCP-012 на людей и определить, на каком расстоянии его влияние становится опасным. Важно выяснить, какие факторы усиливают или ослабляют его эффект, а также существуют ли способы противостоять компульсивному влечению к объекту. Результаты исследований помогут разработать эффективные меры защиты для всего персонала, который может контактировать с объектом."),
		"SCP-066" = list("class" = "Euclid", "task" = "Изучить аномальные звуки, издаваемые SCP-066, чтобы понять их природу и происхождение. Необходимо определить, какие условия приводят к активации объекта и можно ли использовать его уникальные свойства в каких-либо практических целях. Также важно оценить риски, связанные с несанкционированной активацией, и найти способы их предотвращения."),
		"SCP-008" = list("class" = "Keter", "task" = "Изучить полный цикл распространения SCP-008 от момента заражения до проявления всех симптомов. Необходимо задокументировать все стадии развития инфекции и факторы, влияющие на скорость её прогрессирования. Также важно определить возможные методы замедления или остановки инфекции, включая разработку новых протоколов дезинфекции и карантина."),
		"SCP-017" = list("class" = "Keter", "task" = "Изучить поведение SCP-017 в различных условиях освещения, чтобы понять его зависимость от света и теней. Необходимо определить, какие именно спектры и уровни освещения влияют на его активность и передвижение. Важно выяснить, можно ли контролировать его перемещения с помощью управляемого освещения и создать систему, предотвращающую его выход за пределы камеры."),
		"SCP-035" = list("class" = "Keter", "task" = "Изучить воздействие SCP-035 на психику людей, чтобы понять механизмы его психологического влияния. Необходимо выяснить, как именно объект изменяет поведение и когнитивные функции, а также существует ли возможность противостоять его воздействию. Результаты исследований позволят разработать эффективные методы защиты персонала и, возможно, найти способы блокировки его влияния."),
		"SCP-280" = list("class" = "Euclid", "task" = "Изучить поведение SCP-280 в условиях различного освещения, чтобы понять его зависимость от света и теней. Необходимо определить, какие факторы влияют на его активность и что вызывает его перемещения. Важно выяснить, можно ли контролировать его передвижение с помощью управляемого освещения и разработать эффективные методы сдерживания."),
		"SCP-247" = list("class" = "Euclid", "task" = "Изучить поведение SCP-247 и факторы, вызывающие его агрессивные реакции. Необходимо выяснить, какие именно стимулы провоцируют агрессию и можно ли предсказать его поведение на основе внешних условий. Важно разработать новые методы сдерживания и контроля, основанные на понимании поведенческих паттернов объекта."),
		"SCP-457" = list("class" = "Keter", "task" = "Изучить температурные аномалии SCP-457 и факторы, влияющие на его активность. Необходимо выяснить, что именно вызывает тепловые всплески и можно ли контролировать его температуру извне. Результаты исследований помогут разработать эффективные методы стабилизации объекта и предотвращения неконтролируемых вспышек активности."),
		"SCP-939" = list("class" = "Euclid", "task" = "Изучить способность SCP-939 имитировать человеческую речь и оценить его интеллектуальные способности. Необходимо понять, насколько осмысленными являются его звуки и существует ли возможность установления двусторонней коммуникации с объектом. Также важно оценить, представляет ли его коммуникативная активность угрозу для персонала или может быть использована в целях наблюдения."),
		"SCP-1507" = list("class" = "Euclid", "task" = "Изучить социальное поведение SCP-1507 и структуру их иерархии внутри группы. Необходимо выяснить, как организовано их взаимодействие и существуют ли лидеры или определённые роли в стаде. Также важно оценить потенциальные угрозы при массовом содержании и разработать рекомендации по оптимизации условий."),
		"SCP-2427-3" = list("class" = "Keter", "task" = "Изучить аномальное поведение SCP-2427-3, механического объекта, проявляющего признаки разумной активности. Необходимо выяснить, какие факторы влияют на его перемещения и взаимодействие с окружающей средой, а также определить, существует ли система управления или автономные механизмы, управляющие его действиями. Важно оценить потенциальные угрозы, которые объект может представлять для персонала и инфраструктуры Зоны-53, и разработать методы контроля его передвижения.")
	)

	var/scp_block_1 = ""
	var/scp_block_2 = ""

	var/counter = 1
	for(var/scp_id in selected_scps)
		var/list/data = scp_data[scp_id]
		var/block = ""
		block += "ОБЪЕКТ: " + scp_id + "\n"
		block += "КЛАСС ОБЪЕКТА: " + data["class"] + "\n"
		block += "ЗАДАЧА ИССЛЕДОВАНИЯ:\n"
		block += data["task"]

		if(counter == 1)
			scp_block_1 = block
		else
			scp_block_2 = block
		counter++

	var/datum/computer_file/data/text/paperwork/foundation_goal/doc = new()
	var/final_text = doc.stored_data

	final_text = replacetext(final_text, "%doc_number%", "[doc_number]")
	final_text = replacetext(final_text, "%prev_date%", "[prev_date]")
	final_text = replacetext(final_text, "%scp_block_1%", scp_block_1)
	final_text = replacetext(final_text, "%scp_block_2%", scp_block_2)

	return final_text

/datum/foundation_goal/proc/send_report()
	command_announcement.Announce(
		"Поступила новая директива Совета О5 с перечнем приоритетных исследований. Документ направлен на консоли командования.",
		"Входящая директива Совета О5"
	)

	for(var/obj/item/modular_computer/console/preset/cardslot/command/C in world)
		var/turf/T = get_turf(C)
		new /obj/item/paper(T, report_message, "Директива Совета О5")
