{{if data.failTime}}
<div class='glass-panel' style="text-align: center; border-color: rgba(238, 0, 0, 0.5);">
	<h3 style="color: #ee0000; font-size: 16px;">⚠ SYSTEM FAILURE</h3>
	<div style="color: rgba(255,255,255,0.7); margin: 8px 0;">
		<i>I/O regulators malfunction detected! Waiting for system reboot...</i><br><br>
		<div style="font-size: 24px; font-weight: bold; color: #ee0000; text-shadow: 0 0 20px rgba(238,0,0,0.5);">
			{{:data.failTime}}s
		</div>
		<div style="font-size: 11px; color: rgba(255,255,255,0.5); margin-top: 4px;">automatic reboot</div>
	</div>
	<div style="margin-top: 12px;">
		{{:helper.link('Reboot Now', 'refresh', {'reboot' : 1})}}
	</div>
</div>
{{else}}
<div style="min-width: 480px; max-width: 580px; margin: 0 auto;">

	<!-- Header -->
	<div class="glass-panel" style="text-align: center; padding: 12px; margin-bottom: 12px;">
		<h2 style="margin: 0; padding: 0; font-size: 18px; letter-spacing: 2px; text-transform: uppercase; color: #8BA5C4;">Power Control</h2>
		<div class="header-accent" style="margin: 6px 0;"></div>
		<div style="font-size: 10px; color: rgba(255,255,255,0.4); letter-spacing: 1px;">AREA POWER CONTROLLER</div>
	</div>

	<!-- Lock Status -->
	{{if data.siliconUser}}
	<div style="text-align: center; margin-bottom: 10px;">
		<div style="display: inline-block; background: rgba(0,0,0,0.3); border-radius: 20px; padding: 4px 16px; border: 1px solid rgba(64,98,138,0.2);">
			<span style="color: rgba(255,255,255,0.5); font-size: 10px; margin-right: 8px;">Interface Lock:</span>
			{{:helper.link('🔒 Engaged', 'locked', {'toggleaccess' : 1}, data.locked ? 'selected' : null)}}
			{{:helper.link('🔓 Disengaged', 'unlocked', {'toggleaccess' : 1}, data.malfStatus >= 2 ? 'linkOff' : (data.locked ? null : 'selected'))}}
		</div>
	</div>
	{{else}}
		{{if data.locked}}
	<div class="notice" style="text-align: center; margin-bottom: 10px;">
		🔒 Swipe an ID card to unlock this interface
	</div>
		{{else}}
	<div class="notice info" style="text-align: center; margin-bottom: 10px;">
		🔓 Swipe an ID card to lock this interface
	</div>
		{{/if}}
	{{/if}}

	<!-- Power Status Section -->
	<div class="modern-card">
		<div class="modern-card-title">Power Status</div>

		<!-- Main Breaker -->
		<div class="power-bar-container">
			<span class="power-bar-label" style="width: 130px;">⏻ Main Breaker:</span>
			{{if data.locked && !data.siliconUser}}
				{{if data.isOperating}}
					<span style="display: inline-block; padding: 4px 16px; background: rgba(79, 117, 41, 0.2); border: 1px solid rgba(79, 117, 41, 0.4); border-radius: 20px; color: #4f7529; font-weight: bold;"><span class="status-dot good"></span>ON</span>
				{{else}}
					<span style="display: inline-block; padding: 4px 16px; background: rgba(238, 0, 0, 0.2); border: 1px solid rgba(238, 0, 0, 0.4); border-radius: 20px; color: #ee0000; font-weight: bold;"><span class="status-dot bad"></span>OFF</span>
				{{/if}}
			{{else}}
				{{:helper.link('⏻ ON ', 'power', {'breaker' : 1}, data.isOperating ? 'selected' : null)}}
				{{:helper.link('⏻ OFF ', 'close', {'breaker' : 1}, data.isOperating ? null : 'selected')}}
			{{/if}}
		</div>

		<!-- External Power -->
		<div class="power-bar-container">
			<span class="power-bar-label" style="width: 130px;">External Power:</span>
			{{if data.externalPower == 2}}
				<span class="good"><span class="status-dot good"></span>Good</span>
			{{else data.externalPower == 1}}
				<span class="average"><span class="status-dot average"></span>Low</span>
			{{else}}
				<span class="bad"><span class="status-dot bad"></span>None</span>
			{{/if}}
		</div>

		<!-- Power Cell -->
		<div class="power-bar-container">
			<span class="power-bar-label" style="width: 130px;">Power Cell:</span>
			{{if data.powerCellStatus == null}}
				<span class="bad">⚠ Power cell removed.</span>
			{{else}}
				<div class="power-bar-track" style="flex: 1;">
					<div class="power-bar-fill {{if data.powerCellStatus >= 50}}good{{else data.powerCellStatus >= 25}}average{{else}}bad{{/if}}" style="width: {{:data.powerCellStatus}}%;">
						<span class="power-bar-text">{{:helper.round(data.powerCellStatus*10)/10}}%</span>
					</div>
				</div>
			{{/if}}
		</div>

		<!-- Charge Mode -->
		{{if data.powerCellStatus != null}}
		<div class="power-bar-container">
			<span class="power-bar-label" style="width: 130px;">Charge Mode:</span>
			{{if data.locked && !data.siliconUser}}
				{{if data.chargeMode}}
					<span class="good"><span class="status-dot good"></span>Auto</span>
				{{else}}
					<span class="bad"><span class="status-dot bad"></span>Off</span>
				{{/if}}
			{{else}}
				{{:helper.link('Auto', 'refresh', {'cmode' : 1}, data.chargeMode ? 'selected' : null)}}
				{{:helper.link('Off', 'close', {'cmode' : 1}, data.chargeMode ? null : 'selected')}}
			{{/if}}
			<span style="margin-left: 12px; font-size: 10px;">
				{{if data.chargingStatus > 1}}
					<span class="good">[Fully Charged]</span>
				{{else data.chargingStatus == 1}}
					<span class="average">[Charging]</span>
				{{else}}
					<span class="bad">[Not Charging]</span>
				{{/if}}
			</span>
		</div>
		{{/if}}
	</div>

	<!-- Power Channels Section -->
	<div class="modern-card">
		<div class="modern-card-title">Power Channels</div>
		<div class="channel-grid">
			{{for data.powerChannels}}
			<div class="channel-card">
				<h4>{{:value.title}}</h4>
				<div class="channel-value {{if value.status < data.pChan_On}}bad{{else}}good{{/if}}">
					{{:value.powerLoad}}<span style="font-size: 10px; opacity: 0.6;">W</span>
				</div>
				<div class="channel-status" style="{{if value.status < data.pChan_On}}background: rgba(238,0,0,0.2); color: #ee0000; border: 1px solid rgba(238,0,0,0.3);{{else}}background: rgba(79,117,41,0.2); color: #4f7529; border: 1px solid rgba(79,117,41,0.3);{{/if}}">
					{{if value.status < data.pChan_On}}OFF{{else}}ON{{/if}}
					{{if data.locked}}
						{{if value.status == data.pChan_Off_A || value.status == data.pChan_On_A}}· AUTO{{else}}· MAN{{/if}}
					{{/if}}
				</div>
				{{if !data.locked || data.siliconUser}}
				<div style="margin-top: 6px; display: flex; gap: 2px; justify-content: center;">
					{{:helper.link('A', 'refresh', value.topicParams.auto, (value.status == data.pChan_Off_A || value.status == data.pChan_On_A) ? 'selected' : null)}}
					{{:helper.link('I', 'power', value.topicParams.on, (value.status == data.pChan_Off_T || value.status == data.pChan_On) ? 'selected' : null)}}
					{{:helper.link('O', 'close', value.topicParams.off, (value.status == data.pChan_Off) ? 'selected' : null)}}
				</div>
				{{/if}}
			</div>
			{{/for}}
		</div>

		<!-- Total Load -->
		<div class="header-accent"></div>
		<div class="power-bar-container" style="margin-top: 8px;">
			<span class="power-bar-label" style="width: 130px; font-weight: bold; font-size: 13px;">Total Load:</span>
			<span style="font-size: 16px; font-weight: bold;">
				{{:data.totalLoad}}<span style="font-size: 11px; opacity: 0.6;">W</span>
				{{if data.totalCharging}}
				<span style="font-size: 11px; color: #4f7529;">(+ {{:data.totalCharging}}W Charging)</span>
				{{/if}}
			</span>
		</div>
	</div>

	<!-- Cover Lock Section -->
	<div class="modern-card">
		<div class="modern-card-title">Security</div>
		<div class="power-bar-container">
			<span class="power-bar-label">Cover Lock:</span>
			{{if data.locked && !data.siliconUser}}
				{{if data.coverLocked}}
					<span class="good"><span class="status-dot good"></span>Engaged</span>
				{{else}}
					<span class="bad"><span class="status-dot bad"></span>Disengaged</span>
				{{/if}}
			{{else}}
				{{:helper.link('🔒 Lock', 'locked', {'lock' : 1}, data.coverLocked ? 'selected' : null)}}
				{{:helper.link('🔓 Unlock', 'unlocked', {'lock' : 1}, data.coverLocked ? null : 'selected')}}
			{{/if}}
		</div>
	</div>

	<!-- Silicon Overrides -->
	{{if data.siliconUser}}
	<div class="modern-card">
		<div class="modern-card-title">🤖 System Overrides</div>
		<div style="display: flex; gap: 6px; flex-wrap: wrap;">
			{{:helper.link('💡 Overload Lighting', 'lightbulb', {'overload' : 1})}}
			{{if data.malfStatus == 1}}
				{{:helper.link('🔧 Override Programming', 'script', {'malfhack' : 1})}}
			{{else data.malfStatus > 1}}
				<div class="notice" style="margin: 0;">🔓 APC Hacked</div>
			{{/if}}
		</div>
	</div>
	{{/if}}

</div>
{{/if}}
