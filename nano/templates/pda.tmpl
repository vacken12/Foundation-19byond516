<!--
Title: PDA UI - Modern Redesign
Used In File(s): \code\game\objects\items\devices\PDA\PDA.dm
 -->
{{if data.owner}}

<!-- Status Bar -->
<div class="pda-status-bar">
	<span id="pdaTime">{{:data.stationTime}}</span>
	<span>{{if data.new_Message}}💬{{else}}📱{{/if}} {{:data.owner}}</span>
	<span>{{:helper.link('✕', 'close', {'choice' : "Close"}, null, '')}}</span>
</div>

<!-- Navigation bar -->
<div style="display: flex; align-items: center; padding: 6px 8px; background: rgba(0,0,0,0.3); border-bottom: 1px solid rgba(64,98,138,0.2);">
	<div style="flex: 1;">
		{{if data.mode != 0}} {{:helper.link('← Back', 'arrowreturn-1-w', {'choice' : "Return"}, null, '')}} {{/if}}
		{{if data.idInserted}} {{:helper.link('🔄 Sync', 'eject', {'choice' : "UpdateInfo"}, null, '')}} {{/if}}
	</div>
</div>

{{if data.mode == 0}} <!-- ===== MAIN MENU ===== -->

	<!-- User Info Card -->
	<div class="modern-card" style="background: linear-gradient(135deg, rgba(64,98,138,0.2), rgba(0,0,0,0.3)); border-color: rgba(64,98,138,0.3);">
		<div style="display: flex; align-items: center; gap: 10px;">
			<div style="font-size: 32px;">👤</div>
			<div style="flex: 1;">
				<div style="font-size: 14px; font-weight: bold; color: #fff;">{{:data.owner}}</div>
				<div style="font-size: 11px; color: rgba(255,255,255,0.6);">{{:data.ownjob}}</div>
			</div>
			<div style="text-align: right;">
				<div style="font-size: 10px; color: rgba(255,255,255,0.4);">ID</div>
				{{:helper.link(data.idLink, 'eject', {'choice' : "Authenticate"}, data.idInserted ? null : 'disabled', '')}}
			</div>
		</div>
	</div>

	<!-- Cartridge Info -->
	<div class="modern-card" style="padding: 6px 12px;">
		<div style="display: flex; align-items: center; justify-content: space-between;">
			<span style="font-size: 10px; color: rgba(255,255,255,0.5);">💾 Cartridge:</span>
			{{if data.cart_loaded==1}}
				{{:helper.link(data.cartridge.name, 'eject', {'choice' : "Eject"}, null, '')}}
			{{else}}
				<span style="color: rgba(255,255,255,0.3); font-size: 10px;">None inserted</span>
			{{/if}}
		</div>
	</div>

	<!-- Apps Grid - General -->
	<div class="modern-card">
		<div class="modern-card-title">📱 Applications</div>
		<div class="pda-app-grid">
			<div class="pda-app-icon" onclick="window.location='byond://?src=\ref[src]&choice=1'">
				<div class="icon-img">📝</div>
				<div class="icon-label">Notes</div>
			</div>
			<div class="pda-app-icon" onclick="window.location='byond://?src=\ref[src]&choice=2'">
				<div class="icon-img">💬</div>
				<div class="icon-label">Messenger{{if data.new_Message}} <span class="bad">●</span>{{/if}}</div>
			</div>
			<div class="pda-app-icon" onclick="window.location='byond://?src=\ref[src]&choice=41'">
				<div class="icon-img">👥</div>
				<div class="icon-label">Crew</div>
			</div>
			<div class="pda-app-icon" onclick="window.location='byond://?src=\ref[src]&choice=6'">
				<div class="icon-img">📰</div>
				<div class="icon-label">News{{if data.new_News}} <span class="bad">●</span>{{/if}}</div>
			</div>
			<div class="pda-app-icon" onclick="window.location='byond://?src=\ref[src]&choice=3'">
				<div class="icon-img">🌬️</div>
				<div class="icon-label">Atmos</div>
			</div>
			<div class="pda-app-icon" onclick="window.location='byond://?src=\ref[src]&choice=Light'">
				<div class="icon-img">🔦</div>
				<div class="icon-label">{{if data.fon==1}}ON{{else}}OFF{{/if}}</div>
			</div>
		</div>
	</div>

	<!-- Cartridge Apps -->
	{{if data.cartridge}}
	<div class="modern-card">
		<div class="modern-card-title">🔌 Cartridge Apps</div>
		<div class="pda-app-grid">
			{{if data.cartridge.access.access_clown == 1}}
			<div class="pda-app-icon" onclick="window.location='byond://?src=\ref[src]&choice=Honk'">
				<div class="icon-img">🤡</div>
				<div class="icon-label">Honk</div>
			</div>
			{{/if}}
			{{if data.cartridge.access.access_engine == 1}}
			<div class="pda-app-icon" onclick="window.location='byond://?src=\ref[src]&choice=43'">
				<div class="icon-img">⚡</div>
				<div class="icon-label">Power</div>
			</div>
			{{/if}}
			{{if data.cartridge.access.access_quartermaster == 1}}
			<div class="pda-app-icon" onclick="window.location='byond://?src=\ref[src]&choice=47'">
				<div class="icon-img">📦</div>
				<div class="icon-label">Supply</div>
			</div>
			<div class="pda-app-icon" onclick="window.location='byond://?src=\ref[src]&choice=48'">
				<div class="icon-img">🤖</div>
				<div class="icon-label">MULE</div>
			</div>
			{{/if}}
			{{if data.cartridge.access.access_status_display == 1}}
			<div class="pda-app-icon" onclick="window.location='byond://?src=\ref[src]&choice=42'">
				<div class="icon-img">🖥️</div>
				<div class="icon-label">Status</div>
			</div>
			{{/if}}
			{{if data.cartridge.access.access_janitor==1}}
			<div class="pda-app-icon" onclick="window.location='byond://?src=\ref[src]&choice=49'">
				<div class="icon-img">🧹</div>
				<div class="icon-label">Custodial</div>
			</div>
			{{/if}}
			{{if data.cartridge.radio == 2}}
			<div class="pda-app-icon" onclick="window.location='byond://?src=\ref[src]&choice=40'">
				<div class="icon-img">📡</div>
				<div class="icon-label">Signaler</div>
			</div>
			{{/if}}
			{{if data.cartridge.access.access_reagent_scanner==1}}
			<div class="pda-app-icon" onclick="window.location='byond://?src=\ref[src]&choice=Reagent Scan'">
				<div class="icon-img">🧪</div>
				<div class="icon-label">Reagent{{if data.scanmode == 3}} ✅{{/if}}</div>
			</div>
			{{/if}}
			{{if data.cartridge.access.access_engine==1}}
			<div class="pda-app-icon" onclick="window.location='byond://?src=\ref[src]&choice=Halogen Counter'">
				<div class="icon-img">💡</div>
				<div class="icon-label">Halogen{{if data.scanmode == 4}} ✅{{/if}}</div>
			</div>
			{{/if}}
			{{if data.cartridge.access.access_atmos==1}}
			<div class="pda-app-icon" onclick="window.location='byond://?src=\ref[src]&choice=Gas Scan'">
				<div class="icon-img">🫧</div>
				<div class="icon-label">Gas{{if data.scanmode == 5}} ✅{{/if}}</div>
			</div>
			{{/if}}
			{{if data.cartridge.access.access_remote_door==1}}
			<div class="pda-app-icon" onclick="window.location='byond://?src=\ref[src]&choice=Toggle Door'">
				<div class="icon-img">🚪</div>
				<div class="icon-label">Door</div>
			</div>
			{{/if}}
		</div>
	</div>
	{{/if}}

	<!-- pAI -->
	{{if data.pai}}
	<div class="modern-card">
		<div class="modern-card-title">🤖 pAI</div>
		<div class="pda-app-grid">
			<div class="pda-app-icon" onclick="window.location='byond://?src=\ref[src]&choice=pai&option=1'">
				<div class="icon-img">⚙️</div>
				<div class="icon-label">Config</div>
			</div>
			<div class="pda-app-icon" onclick="window.location='byond://?src=\ref[src]&choice=pai&option=2'">
				<div class="icon-img">⏏️</div>
				<div class="icon-label">Eject</div>
			</div>
		</div>
	</div>
	{{/if}}

{{else data.mode == 1}} <!-- ===== NOTEKEEPER ===== -->
	<div class="modern-card">
		<div class="modern-card-title">📝 Notes</div>
		<div class="statusDisplayRecords" style="min-height: 100px;">
			<div class="item">
				<div class="itemContent" style="width: 100%;">
					<span class="average">{{:data.note}}</span>
				</div>
			</div>
		</div>
		<div style="text-align: center; margin-top: 8px;">
			{{:helper.link('✏️ Edit Notes', 'gear', {'choice' : "Edit"}, null, '')}}
		</div>
	</div>

{{else data.mode == 2}} <!-- ===== MESSENGER ===== -->
	<div class="modern-card">
		<div class="modern-card-title" style="display: flex; align-items: center; gap: 8px;">
			💬 SpaceMessenger V4
			<span style="flex:1;"></span>
			<span style="font-size: 9px; opacity: 0.5;">{{:data.message_silent==1 ? '🔇' : '🔔'}}</span>
		</div>

		<div style="display: flex; gap: 4px; flex-wrap: wrap; margin-bottom: 8px;">
			{{:helper.link(data.message_silent==1 ? '🔇 Silent' : '🔔 Sound', data.message_silent==1 ? 'volume-off' : 'volume-on', {'choice' : "Toggle Ringer"}, null, '')}}
			{{:helper.link(data.toff==1 ? '✈️ Offline' : '🟢 Online', data.toff==1 ? 'close':'check', {'choice' : "Toggle Messenger"}, null, '')}}
			{{:helper.link('🎵 Ringtone', 'comment', {'choice' : "Ringtone"}, null, '')}}
			{{:helper.link('🗑️ Clear All', 'trash', {'choice' : "Clear", 'option' : "All"}, null, '')}}
		</div>
	</div>

	{{if data.toff == 0}}
		{{if data.cartridge && data.cartridge.charges}}
		<div style="padding: 4px 12px; background: rgba(205,101,0,0.15); border: 1px solid rgba(205,101,0,0.3); border-radius: 8px; margin: 4px 0; font-size: 10px; color: #cd6500;">
			⚠ {{:data.cartridge.charges}}
			{{if data.cartridge.access.access_detonate_pda}} detonation charges {{/if}}
			{{if data.cartridge.access.access_clown || data.cartridge.access.access_mime}} viral files {{/if}}
			left
		</div>
		{{/if}}

		{{if data.pda_count == 0}}
		<div class="modern-card" style="text-align: center; padding: 20px;">
			<div style="font-size: 36px; opacity: 0.3;">📡</div>
			<div style="color: rgba(255,255,255,0.4); margin-top: 8px;">No other PDAs located</div>
		</div>
		{{else}}
		<div class="modern-card">
			<div class="modern-card-title">💬 Conversations</div>
			{{for data.convopdas}}
			<div style="display: flex; align-items: center; padding: 6px 8px; margin: 2px 0; background: rgba(64,98,138,0.1); border-radius: 8px;">
				<div style="flex: 1;">
					{{:helper.link('💬 ' + value.Name, 'circle-arrow-s', {'choice' : "Select Conversation", 'convo' : value.Reference }, null, '')}}
				</div>
				{{if data.cartridge}}
					{{if data.cartridge.access.access_detonate_pda && value.Detonate}}
						{{:helper.link('💥', 'radiation', {'choice' : "Detonate", 'target' : value.Reference}, null, '')}}
					{{/if}}
					{{if data.cartridge.access.access_clown}}
						{{:helper.link('🤡', 'star', {'choice' : "Send Honk", 'target' : value.Reference}, null, '')}}
					{{/if}}
					{{if data.cartridge.access.access_mime}}
						{{:helper.link('🤫', 'circle-arrow-s', {'choice' : "Send Silence", 'target' : value.Reference}, null, '')}}
					{{/if}}
				{{/if}}
			</div>
			{{/for}}
		</div>

		<div class="modern-card">
			<div class="modern-card-title">📋 All PDAs</div>
			{{for data.pdas}}
			<div style="display: flex; align-items: center; padding: 6px 8px; margin: 2px 0; background: rgba(0,0,0,0.2); border-radius: 8px;">
				<div style="flex: 1;">
					{{:helper.link('📱 ' + value.Name, 'circle-arrow-s', {'choice' : "Message", 'target' : value.Reference}, null, '')}}
				</div>
				{{if data.cartridge}}
					{{if data.cartridge.access.access_detonate_pda && value.Detonate}}
						{{:helper.link('💥', 'radiation', {'choice' : "Detonate", 'target' : value.Reference}, null, '')}}
					{{/if}}
					{{if data.cartridge.access.access_clown}}
						{{:helper.link('🤡', 'star', {'choice' : "Send Honk", 'target' : value.Reference}, null, '')}}
					{{/if}}
					{{if data.cartridge.access.access_mime}}
						{{:helper.link('🤫', 'circle-arrow-s', {'choice' : "Send Silence", 'target' : value.Reference}, null, '')}}
					{{/if}}
				{{/if}}
			</div>
			{{/for}}
		</div>
		{{/if}}
	{{/if}}

{{else data.mode == 21}} <!-- ===== MESSENGER CONVERSATION ===== -->
	<div class="modern-card">
		<div class="modern-card-title">
			💬 {{:data.convo_name}} <span style="font-size: 9px; opacity: 0.5;">({{:data.convo_job}})</span>
		</div>
		<div style="margin-bottom: 6px;">
			{{:helper.link('🗑️ Delete', 'trash', {'choice' : "Clear", 'option' : "Convo"}, null, '')}}
		</div>
		<div class="statusDisplay" style="overflow: auto; min-height: 120px; max-height: 300px;">
			<div class="item">
				<div class="itemContent" style="width: 100%;">
					{{for data.messages}}
						{{if data.active_conversation == value.target}}
							<div class="convo-bubble {{if value.sent==0}}them{{else}}you{{/if}}">
								<span style="font-size: 8px; opacity: 0.5;">{{:value.timestamp}}</span><br>
								{{if value.sent==0}}
									<b style="color: rgba(64,98,138,0.8);">Them</b>: {{:value.message}}
								{{else}}
									<b style="color: rgba(79,117,41,0.8);">You</b>: {{:value.message}}
								{{/if}}
							</div>
							<div style="clear: both;"></div>
						{{/if}}
					{{/for}}
				</div>
			</div>
		</div>
		<div style="text-align: center; margin-top: 8px;">
			{{:helper.link('✏️ Reply', 'comment', {'choice' : "Message", 'target': data.active_conversation}, null, '')}}
		</div>
	</div>

{{else data.mode == 41}} <!-- ===== MANIFEST ===== -->
	<div class="modern-card">
		<div class="modern-card-title">👥 Crew Manifest</div>
		<div class="statusDisplayRecords">
			<div class="item">
				{{:data.crew_manifest}}
			</div>
		</div>
	</div>

{{else data.mode == 3}} <!-- ===== ATMOSPHERIC SCAN ===== -->
	<div class="modern-card">
		<div class="modern-card-title">🌬️ Atmospheric Scan</div>
		<div class="statusDisplay" style="overflow: auto;">
			<div class="item">
				{{if data.aircontents.reading == 1}}
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 6px; padding: 4px;">
						<div style="background: rgba(0,0,0,0.3); padding: 8px; border-radius: 8px; text-align: center;" class="{{if data.aircontents.pressure < 80 || data.aircontents.pressure > 120}}bad{{else data.aircontents.pressure < 95 || data.aircontents.pressure > 110}}average{{else}}good{{/if}}">
							<div style="font-size: 9px; color: rgba(255,255,255,0.5);">Pressure</div>
							<div style="font-size: 16px; font-weight: bold;">{{:data.aircontents.pressure}} kPa</div>
						</div>
						<div style="background: rgba(0,0,0,0.3); padding: 8px; border-radius: 8px; text-align: center;" class="{{if data.aircontents.temp < 5 || data.aircontents.temp > 35}}bad{{else data.aircontents.temp < 15 || data.aircontents.temp > 25}}average{{else}}good{{/if}}">
							<div style="font-size: 9px; color: rgba(255,255,255,0.5);">Temperature</div>
							<div style="font-size: 16px; font-weight: bold;">{{:data.aircontents.temp}}°C</div>
						</div>
						<div style="background: rgba(0,0,0,0.3); padding: 8px; border-radius: 8px; text-align: center;" class="{{if data.aircontents.oxygen < 17}}bad{{else data.aircontents.oxygen < 19}}average{{else}}good{{/if}}">
							<div style="font-size: 9px; color: rgba(255,255,255,0.5);">O₂</div>
							<div style="font-size: 16px; font-weight: bold;">{{:data.aircontents.oxygen}}%</div>
						</div>
						<div style="background: rgba(0,0,0,0.3); padding: 8px; border-radius: 8px; text-align: center;" class="{{if data.aircontents.nitrogen > 82}}bad{{else data.aircontents.nitrogen > 80}}average{{else}}good{{/if}}">
							<div style="font-size: 9px; color: rgba(255,255,255,0.5);">N₂</div>
							<div style="font-size: 16px; font-weight: bold;">{{:data.aircontents.nitrogen}}%</div>
						</div>
						<div style="background: rgba(0,0,0,0.3); padding: 8px; border-radius: 8px; text-align: center;" class="{{if data.aircontents.carbon_dioxide > 5}}bad{{else}}good{{/if}}">
							<div style="font-size: 9px; color: rgba(255,255,255,0.5);">CO₂</div>
							<div style="font-size: 16px; font-weight: bold;">{{:data.aircontents.carbon_dioxide}}%</div>
						</div>
						<div style="background: rgba(0,0,0,0.3); padding: 8px; border-radius: 8px; text-align: center;" class="{{if data.aircontents.phoron > 0}}bad{{else}}good{{/if}}">
							<div style="font-size: 9px; color: rgba(255,255,255,0.5);">Phoron</div>
							<div style="font-size: 16px; font-weight: bold;">{{:data.aircontents.phoron}}%</div>
						</div>
					</div>
				{{else}}
					<div style="text-align: center; padding: 20px;">
						<div style="font-size: 36px; opacity: 0.3;">🔌</div>
						<div class="average"><b>Unable to get air reading</b></div>
					</div>
				{{/if}}
			</div>
		</div>
	</div>

{{else data.mode == 40}} <!-- ===== SIGNALER ===== -->
	<div class="modern-card">
		<div class="modern-card-title">📡 Remote Signaling System</div>
		<div class="statusDisplay" style="text-align: center;">
			<div style="font-size: 28px; font-weight: bold; letter-spacing: 2px; margin: 8px 0;">{{:data.records.signal_freq}}</div>
			<div style="font-size: 10px; color: rgba(255,255,255,0.4);">Frequency</div>
			<div style="margin: 6px 0; display: flex; gap: 2px; justify-content: center;">
				{{:helper.link('-1', null, {'cartmenu' : "1", 'choice' : "Signal Frequency", 'sfreq' : "-10"}, null, null)}}
				{{:helper.link('-.2', null, {'cartmenu' : "1", 'choice' : "Signal Frequency", 'sfreq' : "-2"}, null, null)}}
				{{:helper.link('+.2', null, {'cartmenu' : "1", 'choice' : "Signal Frequency", 'sfreq' : "2"}, null, null)}}
				{{:helper.link('+1', null, {'cartmenu' : "1", 'choice' : "Signal Frequency", 'sfreq' : "10"}, null, null)}}
			</div>
			<div class="header-accent"></div>
			<div style="font-size: 24px; font-weight: bold; margin: 8px 0; color: #cd6500;">{{:data.records.signal_code}}</div>
			<div style="font-size: 10px; color: rgba(255,255,255,0.4);">Code</div>
			<div style="margin: 6px 0; display: flex; gap: 2px; justify-content: center;">
				{{:helper.link('-5', null, {'cartmenu' : "1", 'choice' : "Signal Code", 'scode' : "-5"}, null, null)}}
				{{:helper.link('-1', null, {'cartmenu' : "1", 'choice' : "Signal Code", 'scode' : "-1"}, null, null)}}
				{{:helper.link('+1', null, {'cartmenu' : "1", 'choice' : "Signal Code", 'scode' : "1"}, null, null)}}
				{{:helper.link('+5', null, {'cartmenu' : "1", 'choice' : "Signal Code", 'scode' : "5"}, null, null)}}
			</div>
			<div style="margin-top: 12px;">
				{{:helper.link('📡 Send Signal', 'radiation', {'cartmenu' : "1", 'choice' : "Send Signal"}, null, 'selected')}}
			</div>
		</div>
	</div>

{{else data.mode == 42}} <!-- ===== STATUS DISPLAY ===== -->
	<div class="modern-card">
		<div class="modern-card-title">🖥️ Status Displays</div>
		<div class="statusDisplay">
			<div style="margin-bottom: 8px;">
				<b>General</b>:<br>
				<div style="display: flex; gap: 2px; flex-wrap: wrap; margin-top: 4px;">
					{{:helper.link('Clear', 'trash', {'cartmenu' : "1", 'choice' : "Status", 'statdisp' : "blank"}, null, null)}}
					{{:helper.link('🕐 Time', 'gear', {'cartmenu' : "1", 'choice' : 'Status', 'statdisp' : "time"}, null, null)}}
					{{:helper.link('🚀 Shuttle', 'gear', {'cartmenu' : "1", 'choice' : "Status", 'statdisp' : "shuttle"}, null, null)}}
					{{:helper.link('✏️ Message', 'gear', {'cartmenu' : "1", 'choice' : "Status", 'statdisp' : "message"}, null, null)}}
				</div>
			</div>
			<div class="header-accent"></div>
			<div style="margin: 8px 0;">
				<div style="display: flex; align-items: center; padding: 4px 0;">
					<span style="width: 100px; color: rgba(255,255,255,0.5);">Line 1:</span>
					{{:helper.link(data.records.message1 + ' (set)', 'pencil', {'cartmenu' : "1", 'choice' : "Status",'statdisp' : "setmsg1"}, null, null)}}
				</div>
				<div style="display: flex; align-items: center; padding: 4px 0;">
					<span style="width: 100px; color: rgba(255,255,255,0.5);">Line 2:</span>
					{{:helper.link(data.records.message2 + ' (set)', 'pencil', {'cartmenu' : "1", 'choice' : "Status",'statdisp' : "setmsg2"}, null, null)}}
				</div>
			</div>
			<div class="header-accent"></div>
			<div style="margin-top: 8px;">
				<b>Alert</b>:<br>
				<div style="display: flex; gap: 2px; flex-wrap: wrap; margin-top: 4px;">
					{{:helper.link('None', 'alert', {'cartmenu' : "1", 'choice' : "Status",'statdisp' : "image", 'image' : "default"}, null, null)}}
					{{:helper.link('⚠️ Security', 'alert', {'cartmenu' : "1", 'choice' : "Status",'statdisp' : 'alert'}, null, null)}}
					{{:helper.link('🔒 Lockdown', 'caution', {'cartmenu' : "1", 'choice' : "Status",'statdisp' : "image", 'image' : "lockdown"}, null, null)}}
